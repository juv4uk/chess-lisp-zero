; Deterministic single-threaded PUCT reference for chess-lisp-zero.
; Node value_sum is from that node's side-to-move perspective, therefore a
; parent selects a child using -Q(child).  The default API uses uniform priors;
; puct-run-with-priors accepts an injected provider without making a neural
; runtime part of the semantic core.

(def puct-position-field 0)
(def puct-move-field 1)
(def puct-prior-field 2)
(def puct-visits-field 3)
(def puct-value-sum-field 4)
(def puct-children-field 5)

(def puct-node
  (lambda (position move prior)
    (let ((node (make-vector 6)))
      ((lambda ()
        (vector-set! node puct-position-field position)
        (vector-set! node puct-move-field move)
        (vector-set! node puct-prior-field prior)
        (vector-set! node puct-visits-field 0)
        (vector-set! node puct-value-sum-field 0)
        (vector-set! node puct-children-field (quote ()))
        node)))))

(def puct-position (lambda (node) (vector-ref node puct-position-field)))
(def puct-move (lambda (node) (vector-ref node puct-move-field)))
(def puct-prior (lambda (node) (vector-ref node puct-prior-field)))
(def puct-visits (lambda (node) (vector-ref node puct-visits-field)))
(def puct-value-sum (lambda (node) (vector-ref node puct-value-sum-field)))
(def puct-children (lambda (node) (vector-ref node puct-children-field)))

(def puct-q
  (lambda (node)
    (cond ((eq (puct-visits node) 0) 0)
          (t (/ (puct-value-sum node) (puct-visits node))))))

(def puct-score
  (lambda (parent child cpuct)
    (+ (- 0 (puct-q child))
       (/ (* cpuct (puct-prior child)
             (sqrt (cond ((eq (puct-visits parent) 0) 1)
                         (t (puct-visits parent)))))
          (+ 1 (puct-visits child))))))

(def puct-select-best-from
  (lambda (parent children cpuct best best-score seen)
    (cond ((atom children) best)
          (t (let* ((child (car children))
                    (score (puct-score parent child cpuct)))
               (cond ((or (not seen) (> score best-score))
                      (puct-select-best-from parent (cdr children) cpuct
                        child score t))
                     (t (puct-select-best-from parent (cdr children) cpuct
                          best best-score seen))))))))

(def puct-select-best
  (lambda (parent cpuct)
    (puct-select-best-from parent (puct-children parent) cpuct
      (quote ()) 0 (quote ()))))

(def puct-uniform-weights
  (lambda (moves)
    (cond ((atom moves) (quote ()))
          (t (cons 1 (puct-uniform-weights (cdr moves)))))))

(def puct-uniform-prior-provider
  (lambda (position moves)
    (puct-uniform-weights moves)))

(def puct-prior-weight-total
  (lambda (weights total)
    (cond ((atom weights) total)
          ((< (car weights) 0)
           (error "PUCT prior weights must be non-negative"))
          (t (puct-prior-weight-total (cdr weights) (+ total (car weights)))))))

(def puct-normalize-priors-from
  (lambda (moves weights total accepted)
    (cond
      ((and (atom moves) (atom weights)) (reverse accepted))
      ((or (atom moves) (atom weights))
       (error "PUCT prior weight count must match legal move count"))
      (t (puct-normalize-priors-from (cdr moves) (cdr weights) total
           (cons (/ (car weights) total) accepted))))))

(def puct-normalize-priors
  (lambda (moves weights)
    (let ((total (puct-prior-weight-total weights 0)))
      (cond ((<= total 0) (error "PUCT prior weights must have positive total"))
            (t (puct-normalize-priors-from moves weights total (quote ())))))))

(def puct-make-children-with-priors
  (lambda (position moves priors accepted)
    (cond ((atom moves) (reverse accepted))
          (t (let ((move (car moves)))
               (puct-make-children-with-priors position (cdr moves) (cdr priors)
                 (cons (puct-node (chess-apply-move position move)
                         move (car priors))
                   accepted)))))))

(def puct-expand-with-priors!
  (lambda (node prior-provider)
    (let ((moves (chess-legal-moves (puct-position node))))
      (cond ((atom moves) (quote ()))
            (t (let* ((weights (prior-provider (puct-position node) moves))
                      (priors (puct-normalize-priors moves weights))
                      (children
                        (puct-make-children-with-priors
                          (puct-position node) moves priors (quote ()))))
                 ((lambda ()
                   (vector-set! node puct-children-field children)
                   children))))))))

(def puct-expand!
  (lambda (node)
    (puct-expand-with-priors! node puct-uniform-prior-provider)))

; Returns leaf-first path: (leaf ... root).
(def puct-select-path
  (lambda (node cpuct path)
    (let ((next-path (cons node path)))
      (cond ((atom (puct-children node)) next-path)
            (t (puct-select-path (puct-select-best node cpuct) cpuct next-path))))))

(def puct-terminal-value
  (lambda (position)
    (let ((terminal (chess-terminal-state position)))
      (cond ((eq terminal (quote checkmate)) -1)
            ((eq terminal (quote stalemate)) 0)
            (t (quote ()))))))

(def puct-backup!
  (lambda (path value)
    (cond ((atom path) value)
          (t (let ((node (car path)))
               ((lambda ()
                 (vector-set! node puct-visits-field (+ 1 (puct-visits node)))
                 (vector-set! node puct-value-sum-field
                   (+ value (puct-value-sum node)))
                 (puct-backup! (cdr path) (- 0 value)))))))))

(def puct-simulate-with-priors!
  (lambda (root cpuct evaluator prior-provider)
    (let* ((path (puct-select-path root cpuct (quote ())))
           (leaf (car path))
           (terminal-value (puct-terminal-value (puct-position leaf)))
           (value
             (cond ((eq terminal-value chess-empty)
                    ((lambda ()
                      (puct-expand-with-priors! leaf prior-provider)
                      (evaluator (puct-position leaf)))))
                   (t terminal-value))))
      (puct-backup! path value))))

(def puct-simulate!
  (lambda (root cpuct evaluator)
    (puct-simulate-with-priors! root cpuct evaluator
      puct-uniform-prior-provider)))

(def puct-run-from-with-priors
  (lambda (root remaining cpuct evaluator prior-provider)
    (cond ((eq remaining 0) root)
          (t ((lambda ()
                (puct-simulate-with-priors! root cpuct evaluator prior-provider)
                (puct-run-from-with-priors root (- remaining 1) cpuct evaluator
                  prior-provider)))))))

(def puct-run-with-priors
  (lambda (position simulations cpuct evaluator prior-provider)
    (puct-run-from-with-priors (puct-node position chess-empty 1)
      simulations cpuct evaluator prior-provider)))

(def puct-run-from
  (lambda (root remaining cpuct evaluator)
    (puct-run-from-with-priors root remaining cpuct evaluator
      puct-uniform-prior-provider)))

(def puct-run
  (lambda (position simulations cpuct evaluator)
    (puct-run-from (puct-node position chess-empty 1)
      simulations cpuct evaluator)))

(def puct-best-child-from
  (lambda (children best best-visits seen)
    (cond ((atom children) best)
          (t (let* ((child (car children)) (visits (puct-visits child)))
               (cond ((or (not seen) (> visits best-visits))
                      (puct-best-child-from (cdr children) child visits t))
                     (t (puct-best-child-from (cdr children)
                          best best-visits seen))))))))

(def puct-best-move
  (lambda (root)
    (let ((child (puct-best-child-from (puct-children root)
                   (quote ()) 0 (quote ()))))
      (cond ((eq child chess-empty) chess-empty) (t (puct-move child))))))

(def puct-policy-total-visits
  (lambda (children total)
    (cond ((atom children) total)
          (t (puct-policy-total-visits (cdr children)
               (+ total (puct-visits (car children))))))))

(def puct-policy-temperature-one
  (lambda (children total accepted)
    (cond ((atom children) (reverse accepted))
          (t (let ((child (car children)))
               (puct-policy-temperature-one (cdr children) total
                 (cons (list (puct-move child)
                         (cond ((eq total 0) 0)
                               (t (/ (puct-visits child) total))))
                   accepted)))))))

(def puct-policy-temperature-zero
  (lambda (children best accepted)
    (cond ((atom children) (reverse accepted))
          (t (let ((child (car children)))
               (puct-policy-temperature-zero (cdr children) best
                 (cons (list (puct-move child)
                         (cond ((eq child best) 1) (t 0))) accepted)))))))

(def puct-policy
  (lambda (root temperature)
    (let ((children (puct-children root)))
      (cond ((eq temperature 0)
             (let ((best (puct-best-child-from children (quote ()) 0 (quote ()))))
               (puct-policy-temperature-zero children best (quote ()))))
            ((eq temperature 1)
             (puct-policy-temperature-one children
               (puct-policy-total-visits children 0) (quote ())))
            (t (error "initial PUCT reference supports temperature 0 or 1"))))))

(def puct-clamp-value
  (lambda (value)
    (cond ((> value 1) 1) ((< value -1) -1) (t value))))

(def puct-material-evaluator
  (lambda (position)
    (puct-clamp-value
      (/ (chess-material-score position (chess-position-side position)) 3900))))
