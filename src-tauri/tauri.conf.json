{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "chess-lisp-zero",
  "version": "0.1.0",
  "identifier": "org.chess-lisp-zero.app",
  "build": {
    "beforeDevCommand": "echo 'static dev'",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "echo 'static build'",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "chess-lisp-zero",
        "width": 800,
        "height": 700,
        "minWidth": 640,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
