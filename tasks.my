((tasks . (
  ("CHESS-LISP-ZERO-LICENSE-AND-NOTICE" . (
    (priority . 9.0)
    (capabilities . (documentation licensing research))
    (depends-on . ())
    (origin . chess-lisp-zero)
    (description . "Ratify the repository license with owner authority and add NOTICE-third-party.md covering the MIT chess-alpha-zero lineage before any code or data is copied. Owner decision 2026-08-27: chess.js is not used anywhere in this project (not even as an out-of-tree witness), so it needs no NOTICE entry. Treat model weights and game corpora as separate provenance decisions. STATUS: resolved -- NOTICE-third-party.md exists and lists no unresolved third-party material.")))

  ("CHESS-LISP-ZERO-CHESS-RULES-PERFT" . (
    (priority . 10.0)
    (done . t)
    (capabilities . (my-lisp chess testing))
    (depends-on . ())
    (origin . chess-lisp-zero)
    (description . "Implement the first semantic vertical slice as original .my code: 64-cell position, move representation, pseudo-legal generation, king-safety filtering, apply-move, terminal state, and deterministic perft depth 1..3 fixtures. Start with vectors; do not add Rust bit primitives before profiling. STATUS: completed 2026-08-29 by vyasa -- vertical slice exists (lib/chess.my, tests/perft.my); verified perft(1)=20, perft(2)=400, perft(3)=8902 via 20 independent per-root subtree runs (multi-set matches canonical perft(3) divide table). The apparent depth-3 hang was interpreter throughput (~minutes for 8902 nodes in one process), not non-termination. See docs/PERFT-VERIFY.md.")))

  ("CHESS-LISP-ZERO-TAURI-SHELL-MVP" . (
    (priority . 8.0)
    (capabilities . (tauri rust frontend))
    (depends-on . (CHESS-LISP-ZERO-LICENSE-AND-NOTICE))
    (origin . chess-lisp-zero)
    (description . "Create a minimal buildable Tauri v2 shell and chess-board UI using only license-cleared components. Preserve chess-tauri-zero's rendering and busy-state lessons, but do not import its Python sidecar or binaries. Prove targeted Linux structure/build checks; Windows stays CI evidence.")))

  ("CHESS-LISP-ZERO-EMBEDDED-MYLISP-ACTOR" . (
    (priority . 9.0)
    (capabilities . (rust my-lisp tauri concurrency))
    (depends-on . (CHESS-LISP-ZERO-TAURI-SHELL-MVP))
    (origin . chess-lisp-zero)
    (description . "Embed canonical my-lisp in Tauri through a single-owner runtime actor: one worker creates and owns Session, preloads core.my and chess libraries, accepts typed channel requests, and returns typed results/events. Do not use unsafe shared Session or a CLI sidecar.")))

  ("CHESS-LISP-ZERO-CHESSJS-DIFFERENTIAL" . (
    (priority . 8.0)
    (capabilities . (testing evidence my-lisp chess))
    (depends-on . (CHESS-LISP-ZERO-CHESS-RULES-PERFT))
    (origin . chess-lisp-zero)
    (description . "Build a normalized FEN/legal-move/perft differential gate between the my-lisp chess library and published perft reference data (chess-programming-wiki standard test positions -- starting position, Kiwipete, position 3, etc.). Owner decision 2026-08-27: no chess.js, not even as an out-of-tree witness (tools/witness-chessjs.mjs removed) -- published counts/divide breakdowns are public facts, not third-party code, and need no license/NOTICE entry. Source the reference numbers from the published tables directly (do not hand-transcribe from memory); record exact fixture, expected/actual, source citation and commit SHAs. Name retained for dependency-graph stability even though the witness is no longer chess.js.")))

  ("CHESS-LISP-ZERO-UCI-ADAPTER" . (
    (priority . 6.0)
