    (description . "Add an optional UCI adapter around the my-lisp chess engine for compatibility and differential comparison with chess-tauri-zero. Keep the internal Tauri API typed; UCI is an external adapter, not the in-process authority.")))

  ("CHESS-LISP-ZERO-CPU-BASELINE-PROFILE" . (
    (priority . 7.0)
    (capabilities . (benchmark my-lisp chess evidence))
    (depends-on . (CHESS-LISP-ZERO-CHESS-RULES-PERFT CHESS-LISP-ZERO-CHESSJS-DIFFERENTIAL))
