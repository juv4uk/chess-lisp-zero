(load "lib/chess.my")
(def initial (chess-initial-position))
(print (list (quote legal) (length (chess-legal-moves initial))))
(print (list (quote depth-1) (chess-perft initial 1)))
(print (list (quote depth-2) (chess-perft initial 2)))
(print (list (quote board-restored-a1)
  (vector-ref (chess-position-board initial) 0)))
(print (list (quote board-restored-e2)
  (vector-ref (chess-position-board initial) 12)))

(def mate-board (make-vector 64))
(vector-set! mate-board 56 (quote bk))
(vector-set! mate-board 49 (quote wq))
(vector-set! mate-board 42 (quote wk))
(print (list (quote terminal-mate)
  (chess-terminal-state (chess-position mate-board (quote black)))))

(def stale-board (make-vector 64))
(vector-set! stale-board 56 (quote bk))
(vector-set! stale-board 41 (quote wq))
(vector-set! stale-board 42 (quote wk))
(print (list (quote terminal-stalemate)
  (chess-terminal-state (chess-position stale-board (quote black)))))
